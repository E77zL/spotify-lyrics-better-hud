{
  "name": "spotify-lyrics-hud",
  "version": "5.1.0",
  "description": "类似 QQ 音乐悬浮歌词的 Spotify 桌面歌词插件：读取系统级播放信息（无需登录/无需 Premium），支持透明度/背景色/歌词颜色自定义，Windows 与 macOS 一键安装包",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.spotifylyricshud.app",
    "productName": "Spotify悬浮歌词",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/app-icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/app-icon.icns",
      "category": "public.app-category.music",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "悬浮歌词需要通过 AppleScript 读取 Spotify 当前播放的歌曲信息，用于同步显示歌词。"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Spotify悬浮歌词",
      "artifactName": "SpotifyLyricsHUD-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Spotify悬浮歌词",
      "artifactName": "SpotifyLyricsHUD-${version}-mac.${ext}"
    }
  }
}
